<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Chapter 5 Skin Squad Quiz Game</title><meta name="description" content="Accessible Chapter 5 Integumentary System quiz game with Jeopardy, Speed Run, and Survival modes."><style>
:root{--bg:#07111f;--surface:#0f1f33;--surface2:#172b45;--ink:#f8fbff;--muted:#c7d7ea;--line:#8bb7e0;--cyan:#67e8f9;--yellow:#fde047;--green:#86efac;--red:#fda4af;--focus:#facc15}*{box-sizing:border-box}body{margin:0;background:#07111f;color:var(--ink);font:17px/1.55 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}.skip{position:absolute;top:-80px;left:0;background:#fff;color:#000;padding:.7rem;z-index:5}.skip:focus{top:0}.screen{display:none;min-height:100vh;padding:1rem}.screen.active{display:block}.container{max-width:1180px;margin:auto}h1{font-size:clamp(2.4rem,7vw,5rem);line-height:1;margin:.4rem 0;color:#fff}h2{font-size:2rem;color:#fff}.lead{font-size:1.15rem;color:var(--muted);max-width:760px}.mode-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem;margin:1.3rem 0}.mode{background:var(--surface);border:3px solid var(--line);color:var(--ink);border-radius:.5rem;padding:1rem;text-align:left;cursor:pointer}.mode[aria-pressed=true]{border-color:var(--yellow);background:#243047}.mode strong{display:block;color:var(--cyan);font-size:1.2rem}.btn{border:3px solid var(--cyan);background:#07111f;color:#fff;border-radius:.4rem;padding:.8rem 1rem;font-weight:900;cursor:pointer}.btn.primary{background:var(--cyan);color:#03111c}.btn:focus-visible,.cell:focus-visible,.choice:focus-visible,.mode:focus-visible{outline:4px solid var(--focus);outline-offset:3px}.hud{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.8rem;padding:1rem;border-bottom:2px solid var(--line);background:#0b1728}.score{font-size:1.4rem;font-weight:900;color:var(--yellow)}.meter{width:220px;height:16px;border:2px solid var(--line);border-radius:999px;overflow:hidden;background:#07111f}.meter span{display:block;height:100%;background:var(--green);width:0}.board-wrap{overflow:auto;padding:1rem}.board{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:.45rem;min-width:780px}.cat{background:#12355b;border:2px solid var(--line);padding:.65rem;text-align:center;font-weight:900;color:#fff}.cell{min-height:62px;border:2px solid var(--line);background:#10243b;color:var(--yellow);font-size:1.25rem;font-weight:900;border-radius:.35rem;cursor:pointer}.cell:hover{background:#183b60}.cell.used{background:#26384d;color:#9aa8b8;cursor:not-allowed}.modal{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;align-items:center;justify-content:center;padding:1rem}.modal.show{display:flex}.dialog{background:#fff;color:#111827;border-radius:.55rem;max-width:760px;width:100%;padding:1rem;border:5px solid var(--cyan)}.dialog h3{font-size:1.55rem;margin:.2rem 0}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.choice{border:3px solid #344054;background:#fff;color:#111827;border-radius:.4rem;padding:.85rem;text-align:left;font-weight:800}.choice.correct{border-color:#027a48;background:#ecfdf3}.choice.wrong{border-color:#b42318;background:#fff1f3}.feedback{margin:1rem 0;padding:.8rem;border-radius:.4rem;border:2px solid #667085}.result-card{background:#fff;color:#111827;border-radius:.55rem;padding:1.2rem;border:4px solid var(--cyan);margin-top:1rem}.tiny{color:var(--muted)}@media(max-width:700px){.choices{grid-template-columns:1fr}.hud{align-items:flex-start}.meter{width:100%}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body>
<a class="skip" href="#game-main">Skip to game</a><section id="title" class="screen active"><main class="container" id="game-main"><p class="tiny">AP1 Chapter 5</p><h1>Integumentary System Quiz Game</h1><p class="lead">A 60-question accessible review game. Jeopardy mode uses all five categories and twelve progressive point levels. Speed Run and Survival randomize the same full bank for repeat play.</p><div class="mode-grid" role="group" aria-label="Choose game mode"><button class="mode" data-mode="jeopardy" aria-pressed="true"><strong>Jeopardy</strong>Choose questions by category and point value.</button><button class="mode" data-mode="speed" aria-pressed="false"><strong>Speed Run</strong>Answer 20 randomized questions before time expires.</button><button class="mode" data-mode="survival" aria-pressed="false"><strong>Survival</strong>Keep going through the bank with three misses available.</button></div><button class="btn primary" id="start">Start game</button><p class="tiny">Keyboard tip: Tab to a cell or answer choice, then press Enter.</p></main></section>
<section id="game" class="screen"><div class="hud"><button class="btn" id="home">Change mode</button><div class="score" id="score">$0</div><div id="extra" aria-live="polite"></div><div><div class="meter" role="progressbar" aria-label="Questions answered" aria-valuemin="0" aria-valuemax="60" aria-valuenow="0"><span id="fill"></span></div><span id="progress">0/60</span></div></div><div class="board-wrap"><div class="board" id="board" aria-label="Jeopardy board"></div></div></section>
<section id="results" class="screen"><main class="container"><h2>Game results</h2><div class="result-card"><p id="result-summary"></p><p id="result-details"></p></div><button class="btn primary" id="again">Play again</button><button class="btn" id="mode">Change mode</button></main></section>
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-cat"><div class="dialog"><p id="modal-cat"></p><h3 id="modal-q"></h3><div class="choices" id="choices"></div><div class="feedback" id="feedback" hidden aria-live="polite"></div><button class="btn primary" id="continue" hidden>Continue</button></div></div>
<script>
const CATEGORIES=["System Overview","Epidermis","Dermis and Hypodermis","Color and Vitamin D","Accessories, Repair, Aging"];const QUESTIONS=[{"cat":"System Overview","points":100,"q":"What percentage of body weight is the integumentary system about?","opts":["6%","10%","16%","30%"],"ans":2,"explain":"The chapter identifies the integumentary system as about 16% of body weight."},{"cat":"System Overview","points":200,"q":"Which term means the skin itself?","opts":["Cutaneous membrane","Subcutaneous membrane","Serous membrane","Synovial membrane"],"ans":0,"explain":"The cutaneous membrane is the skin."},{"cat":"System Overview","points":300,"q":"Which is an accessory structure?","opts":["Hair follicle","Femur","Lung","Neuron cell body"],"ans":0,"explain":"Hair follicles, hair, glands, and nails are accessory structures."},{"cat":"System Overview","points":400,"q":"Which function helps defend against ultraviolet radiation?","opts":["Melanin production","Lipid digestion","Bone remodeling","Blood clot transport"],"ans":0,"explain":"Melanin absorbs and dissipates UV radiation."},{"cat":"System Overview","points":500,"q":"Which function directly supports calcium absorption?","opts":["Vitamin D3 synthesis","Keratin shedding","Goosebumps","Bruising"],"ans":0,"explain":"Vitamin D3 activation leads to calcitriol, which supports calcium and phosphate absorption."},{"cat":"System Overview","points":600,"q":"Which structure is the superficial epithelial layer of skin?","opts":["Epidermis","Dermis","Hypodermis","Cutaneous plexus"],"ans":0,"explain":"The epidermis is the outer epithelial layer."},{"cat":"System Overview","points":700,"q":"Why is keratin important?","opts":["It strengthens and waterproofs skin","It carries oxygen","It makes earwax","It stores calcium in bone"],"ans":0,"explain":"Keratin protects against abrasion and acts as a water repellent."},{"cat":"System Overview","points":800,"q":"Which is NOT a major integumentary function from the chapter?","opts":["Excretion","Temperature regulation","Sensory detection","Producing red blood cells"],"ans":3,"explain":"Blood cell production is not listed as a skin function."},{"cat":"System Overview","points":900,"q":"Which phrase best fits the fortress analogy?","opts":["Epidermis as walls and gates","Hypodermis as lungs","Nails as kidneys","Dermis as brainstem"],"ans":0,"explain":"The analogy compares the epidermis to protective walls and gates."},{"cat":"System Overview","points":1000,"q":"Which function helps the body notice touch, pressure, pain, and temperature?","opts":["Sensory detection","Lipid storage","Carotene storage","Scab dissolving"],"ans":0,"explain":"Skin contains sensory receptors for external stimuli."},{"cat":"System Overview","points":1100,"q":"Which function involves salts, water, and organic wastes?","opts":["Excretion","Hair color","Fingerprints","Turgor"],"ans":0,"explain":"Glands can excrete salts, water, and organic wastes."},{"cat":"System Overview","points":1200,"q":"A student says skin is passive wrapping. What is the best correction?","opts":["It actively protects, senses, repairs, and regulates","It only stores bone minerals","It has no immune role","It cannot affect homeostasis"],"ans":0,"explain":"The integumentary system actively supports homeostasis and defense."},{"cat":"Epidermis","points":100,"q":"Which cell is most abundant in the epidermis?","opts":["Keratinocyte","Fibroblast","Chondrocyte","Osteocyte"],"ans":0,"explain":"Keratinocytes are the most abundant epidermal cells."},{"cat":"Epidermis","points":200,"q":"Where is thick skin found?","opts":["Palms and soles","Lips only","Back of hand only","External ear only"],"ans":0,"explain":"Thick skin is found on palms and soles."},{"cat":"Epidermis","points":300,"q":"Thin skin has how many keratinocyte layers?","opts":["Two","Three","Four","Seven"],"ans":2,"explain":"Thin skin has four layers of keratinocytes."},{"cat":"Epidermis","points":400,"q":"Which layer is deepest?","opts":["Stratum basale","Stratum corneum","Stratum lucidum","Stratum granulosum"],"ans":0,"explain":"The stratum basale is deepest."},{"cat":"Epidermis","points":500,"q":"Which layer contains 8 to 10 layers connected by desmosomes?","opts":["Stratum spinosum","Stratum lucidum","Stratum corneum","Stratum basale"],"ans":0,"explain":"The stratum spinosum is the spiny layer connected by desmosomes."},{"cat":"Epidermis","points":600,"q":"Which layer has keratin and keratohyalin production?","opts":["Stratum granulosum","Stratum basale","Dermis","Hypodermis"],"ans":0,"explain":"Cells in the stratum granulosum produce keratin and keratohyalin."},{"cat":"Epidermis","points":700,"q":"Which epidermal layer is absent in thin skin?","opts":["Stratum lucidum","Stratum basale","Stratum spinosum","Stratum corneum"],"ans":0,"explain":"The stratum lucidum is only in thick skin."},{"cat":"Epidermis","points":800,"q":"Which layer sheds cells after about two weeks?","opts":["Stratum corneum","Stratum basale","Stratum spinosum","Papillary layer"],"ans":0,"explain":"The stratum corneum is the outer shedding layer."},{"cat":"Epidermis","points":900,"q":"Which cells detect touch in the stratum basale?","opts":["Tactile cells","Fibroblasts","Adipocytes","Macrophages only"],"ans":0,"explain":"Tactile cells are present in the stratum basale."},{"cat":"Epidermis","points":1000,"q":"What increases after serious damage to the stratum corneum?","opts":["Water loss","Melanosome size instantly","Nail growth only","Hair root number"],"ans":0,"explain":"Damage to the barrier increases water loss."},{"cat":"Epidermis","points":1100,"q":"Which factor promotes basal cell division and repair?","opts":["EGF","Sebum","Cerumen","Carotene"],"ans":0,"explain":"Epidermal growth factor promotes basal cell division and epidermal repair."},{"cat":"Epidermis","points":1200,"q":"Top to bottom, which sequence is correct?","opts":["Corneum, lucidum, granulosum, spinosum, basale","Basale, corneum, spinosum, lucidum, granulosum","Dermis, epidermis, hypodermis, nail, hair","Lucidum, basale, corneum, spinosum, granulosum"],"ans":0,"explain":"The mnemonic Come Let's Get SunBurned gives the top-to-bottom order."},{"cat":"Dermis and Hypodermis","points":100,"q":"What are the two dermal layers?","opts":["Papillary and reticular","Basale and corneum","Lucidum and spinosum","Adipose and osseous"],"ans":0,"explain":"The dermis has papillary and reticular layers."},{"cat":"Dermis and Hypodermis","points":200,"q":"Which tissue forms the papillary layer?","opts":["Areolar tissue","Bone","Dense regular tendon","Hyaline cartilage"],"ans":0,"explain":"The papillary layer is areolar tissue."},{"cat":"Dermis and Hypodermis","points":300,"q":"Dermal papillae interlock with:","opts":["epidermal ridges","nail grooves only","hair shafts","sebaceous ducts only"],"ans":0,"explain":"Dermal papillae interlock with epidermal ridges."},{"cat":"Dermis and Hypodermis","points":400,"q":"Which tissue forms the reticular layer?","opts":["Dense irregular connective tissue","Stratified squamous epithelium","Nervous tissue only","Smooth muscle only"],"ans":0,"explain":"The reticular layer is dense irregular connective tissue."},{"cat":"Dermis and Hypodermis","points":500,"q":"What do collagen fibers resist?","opts":["Stretching","Light touch","UV rays directly","Sweat evaporation"],"ans":0,"explain":"Collagen fibers are strong and resist stretching."},{"cat":"Dermis and Hypodermis","points":600,"q":"Elastic fibers mainly allow skin to:","opts":["stretch and recoil","produce melanin","make vitamin D active","form earwax"],"ans":0,"explain":"Elastic fibers provide stretch and recoil."},{"cat":"Dermis and Hypodermis","points":700,"q":"Reduced skin turgor can result from:","opts":["dehydration","more keratin only","extra lucidum","more sebum only"],"ans":0,"explain":"Dehydration, aging, hormones, and UV exposure can reduce turgor."},{"cat":"Dermis and Hypodermis","points":800,"q":"A cut parallel to tension lines usually:","opts":["heals faster with less scarring","never bleeds","destroys melanin","prevents inflammation"],"ans":0,"explain":"Parallel incisions tend to heal faster and scar less."},{"cat":"Dermis and Hypodermis","points":900,"q":"The cutaneous plexus is located in the:","opts":["reticular layer","stratum corneum","nail body","hair shaft"],"ans":0,"explain":"The cutaneous plexus is an arterial network in the reticular layer."},{"cat":"Dermis and Hypodermis","points":1000,"q":"Which receptor detects light touch?","opts":["Tactile corpuscle","Lamellar corpuscle","Melanocyte","Sebaceous gland"],"ans":0,"explain":"Tactile corpuscles detect light touch."},{"cat":"Dermis and Hypodermis","points":1100,"q":"Which layer is also called the hypodermis?","opts":["Subcutaneous layer","Epidermis","Papillary layer","Stratum granulosum"],"ans":0,"explain":"The subcutaneous layer is the hypodermis."},{"cat":"Dermis and Hypodermis","points":1200,"q":"Why are some medications injected into the hypodermis?","opts":["It is accessible and contains subcutaneous tissue","It has the stratum lucidum","It is made of nail cells","It lacks vessels entirely"],"ans":0,"explain":"The hypodermis is a common site for subcutaneous injections."},{"cat":"Color and Vitamin D","points":100,"q":"Which pigment is orange-yellow?","opts":["Carotene","Eumelanin","Sebum","Keratohyalin"],"ans":0,"explain":"Carotene is orange-yellow."},{"cat":"Color and Vitamin D","points":200,"q":"Which cells produce melanin?","opts":["Melanocytes","Fibroblasts","Endothelial cells","Adipocytes"],"ans":0,"explain":"Melanocytes produce melanin."},{"cat":"Color and Vitamin D","points":300,"q":"Where are melanocytes located?","opts":["Stratum basale","Stratum corneum only","Nail body","Hypodermis only"],"ans":0,"explain":"Melanocytes are in the stratum basale."},{"cat":"Color and Vitamin D","points":400,"q":"What are melanosomes?","opts":["Vesicles that store melanin","Sweat ducts","Nail folds","Pressure receptors"],"ans":0,"explain":"Melanin is stored in melanosomes."},{"cat":"Color and Vitamin D","points":500,"q":"Which form of melanin is brown-black?","opts":["Eumelanin","Pheomelanin","Carotene","Calcitriol"],"ans":0,"explain":"Eumelanin is brown-black."},{"cat":"Color and Vitamin D","points":600,"q":"Which form of melanin is red-yellow?","opts":["Pheomelanin","Eumelanin","Cholecalciferol","Sebum"],"ans":0,"explain":"Pheomelanin is red-yellow."},{"cat":"Color and Vitamin D","points":700,"q":"Darker skin is mainly due to larger and more abundant:","opts":["melanosomes","nail roots","sweat pores","tactile corpuscles"],"ans":0,"explain":"Darker skin results from larger and more abundant melanosomes."},{"cat":"Color and Vitamin D","points":800,"q":"A tan is best described as:","opts":["a response to UV damage","proof of healthier skin","vitamin A storage","lack of keratin"],"ans":0,"explain":"Tanning is an emergency response to UV damage."},{"cat":"Color and Vitamin D","points":900,"q":"UV radiation begins vitamin D3 production in the:","opts":["epidermis","kidney only","nail bed","hair shaft"],"ans":0,"explain":"UV acts on epidermal cells."},{"cat":"Color and Vitamin D","points":1000,"q":"Which organs complete activation of vitamin D3?","opts":["Liver and kidneys","Spleen and lungs","Stomach and colon","Heart and thymus"],"ans":0,"explain":"The liver and kidneys process vitamin D3 into active calcitriol."},{"cat":"Color and Vitamin D","points":1100,"q":"Calcitriol helps the small intestine absorb:","opts":["calcium and phosphate","oxygen and carbon dioxide","melanin and keratin","sweat and sebum"],"ans":0,"explain":"Calcitriol supports calcium and phosphate absorption."},{"cat":"Color and Vitamin D","points":1200,"q":"A child with soft, weak, deformed bones from low vitamin D may have:","opts":["rickets","dermatitis","a contusion","a keloid"],"ans":0,"explain":"Rickets can result from insufficient vitamin D3."},{"cat":"Accessories, Repair, Aging","points":100,"q":"Hair is derived from the embryonic:","opts":["epidermis","bone marrow","cartilage","blood plasma"],"ans":0,"explain":"Hair is an accessory structure derived from embryonic epidermis."},{"cat":"Accessories, Repair, Aging","points":200,"q":"Where is hair not found?","opts":["Palms","Scalp","Eyebrows","Armpits after puberty"],"ans":0,"explain":"Hair is absent from palms, soles, lips, and parts of the external genitalia."},{"cat":"Accessories, Repair, Aging","points":300,"q":"What is the visible part of hair?","opts":["Hair shaft","Hair root","Nail bed","Sebaceous duct"],"ans":0,"explain":"The hair shaft extends beyond the skin."},{"cat":"Accessories, Repair, Aging","points":400,"q":"What surrounds the hair root?","opts":["Hair follicle","Lunula","Hyponychium","Stratum lucidum"],"ans":0,"explain":"The follicle surrounds the root."},{"cat":"Accessories, Repair, Aging","points":500,"q":"The root hair plexus contains:","opts":["sensory nerves","bone cells","photoreceptor pigments","calcitriol"],"ans":0,"explain":"The root hair plexus is a network of sensory nerves."},{"cat":"Accessories, Repair, Aging","points":600,"q":"Which muscle causes goosebumps?","opts":["Arrector pili","Masseter","Diaphragm","Orbicularis oris"],"ans":0,"explain":"Arrector pili are smooth muscles attached to follicles."},{"cat":"Accessories, Repair, Aging","points":700,"q":"Which hair is fine and soft?","opts":["Vellus","Terminal","Keloid","Ceruminous"],"ans":0,"explain":"Vellus hairs are fine and soft."},{"cat":"Accessories, Repair, Aging","points":800,"q":"Sebaceous glands secrete:","opts":["sebum","calcitriol","carotene","collagen"],"ans":0,"explain":"Sebaceous glands release sebum."},{"cat":"Accessories, Repair, Aging","points":900,"q":"Apocrine glands secrete into:","opts":["hair follicles","nail roots","bone canals","the liver"],"ans":0,"explain":"Apocrine sweat glands secrete into hair follicles."},{"cat":"Accessories, Repair, Aging","points":1000,"q":"Which glands produce earwax?","opts":["Ceruminous glands","Mammary glands","Sebaceous glands only","Endocrine thyroid glands"],"ans":0,"explain":"Ceruminous glands produce cerumen, or earwax."},{"cat":"Accessories, Repair, Aging","points":1100,"q":"Which repair phase includes fibroblasts producing collagen?","opts":["Proliferation","Inflammatory","Before injury","Pigmentation"],"ans":0,"explain":"Fibroblasts produce collagen in the proliferation phase."},{"cat":"Accessories, Repair, Aging","points":1200,"q":"Which aging effect impairs temperature regulation?","opts":["Reduced glandular activity","More melanosomes","More elastic fibers","Faster cell division"],"ans":0,"explain":"Reduced glandular activity contributes to dry skin and impaired temperature regulation."}];
let mode='jeopardy',score=0,answered=0,correct=0,wrong=0,lives=3,timer=null,time=180,queue=[],current=null,currentCell=null;
document.querySelectorAll('.mode').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('.mode').forEach(x=>x.setAttribute('aria-pressed',String(x===b)))}));
document.getElementById('start').onclick=startGame;document.getElementById('home').onclick=()=>{clearInterval(timer);show('title')};document.getElementById('again').onclick=startGame;document.getElementById('mode').onclick=()=>show('title');
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active',s.id===id));}
function startGame(){score=0;answered=0;correct=0;wrong=0;lives=3;time=180;queue=shuffle([...QUESTIONS]);clearInterval(timer);buildBoard();show('game');updateHud();if(mode==='speed'){timer=setInterval(()=>{time--;updateHud();if(time<=0)endGame()},1000);nextRandom()}if(mode==='survival')nextRandom();}
function buildBoard(){const board=document.getElementById('board');board.innerHTML='';CATEGORIES.forEach(c=>{const h=document.createElement('div');h.className='cat';h.textContent=c;board.appendChild(h)});for(let level=1;level<=12;level++){CATEGORIES.forEach(cat=>{const q=QUESTIONS.find(x=>x.cat===cat&&x.points===level*100);const cell=document.createElement('button');cell.className='cell';cell.textContent='$'+q.points;cell.dataset.id=QUESTIONS.indexOf(q);cell.addEventListener('click',()=>openQ(q,cell));board.appendChild(cell)})}}
function nextRandom(){if(queue.length===0){endGame();return}openQ(queue.shift(),null)}
function openQ(q,cell){if(cell&&cell.classList.contains('used'))return;current=q;currentCell=cell;document.getElementById('modal-cat').textContent=q.cat+' | $'+q.points;document.getElementById('modal-q').textContent=q.q;const box=document.getElementById('choices');box.innerHTML='';q.opts.forEach((o,i)=>{const b=document.createElement('button');b.className='choice';b.textContent=String.fromCharCode(65+i)+'. '+o;b.onclick=()=>answer(i,b);box.appendChild(b)});document.getElementById('feedback').hidden=true;document.getElementById('continue').hidden=true;document.getElementById('modal').classList.add('show');}
function answer(i,btn){const q=current;answered++;const ok=i===q.ans;if(ok){score+=q.points;correct++;}else{wrong++;if(mode==='survival')lives--;}document.querySelectorAll('.choice').forEach((b,idx)=>{b.disabled=true;if(idx===q.ans)b.classList.add('correct');else if(b===btn)b.classList.add('wrong')});const fb=document.getElementById('feedback');fb.hidden=false;fb.textContent=(ok?'Correct. ':'Not quite. ')+q.explain;const cont=document.getElementById('continue');cont.hidden=false;cont.focus();if(currentCell){currentCell.classList.add('used');currentCell.disabled=true;currentCell.textContent='';}updateHud();}
document.getElementById('continue').onclick=()=>{document.getElementById('modal').classList.remove('show');if(mode==='jeopardy'&&answered>=60){endGame();return}if(mode==='survival'&&lives<=0){endGame();return}if(mode==='speed'||mode==='survival')nextRandom();};
function updateHud(){document.getElementById('score').textContent='$'+score.toLocaleString();document.getElementById('fill').style.width=Math.min(100,answered/60*100)+'%';document.querySelector('.meter').setAttribute('aria-valuenow',answered);document.getElementById('progress').textContent=answered+'/60';document.getElementById('extra').textContent=mode==='speed'?'Time: '+time+' seconds':mode==='survival'?'Lives: '+lives:'Jeopardy board';}
function endGame(){clearInterval(timer);document.getElementById('modal').classList.remove('show');show('results');const pct=answered?Math.round(correct/answered*100):0;document.getElementById('result-summary').textContent='Score: $'+score.toLocaleString()+' | Accuracy: '+pct+'%';document.getElementById('result-details').textContent='Correct: '+correct+' | Missed: '+wrong+' | Questions answered: '+answered+'. Review missed categories in the study guide, then play again for a different path through the bank.';}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
</script></body></html>
